{
  "name": "ai-qa-agent",
  "version": "0.5.0",
  "private": true,
  "description": "Evidence-based web QA agent (Express + Playwright): crawls a site and tests links, buttons, forms, inputs, images and mobile menus on desktop and mobile",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "qa": "node agent/runner.js",
    "scan": "node agent/ai-qa-pipeine.js",
    "scan:site": "node agent/ai-qa-pipeine.js --site",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "test:all": "npm test && npm run test:integration",
    "fixture": "node test/fixtures/server.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
